# Copy to .env for local development, and set the same keys in the Vercel
# project settings for production. Never commit the filled-in .env.

# --- Database -----------------------------------------------------------------
# Local Homebrew Postgres:  postgresql://YOUR_USERNAME@localhost:5432/september_mission?schema=public
# Local Docker Postgres:    postgresql://postgres:postgres@localhost:5433/september_mission?schema=public
# Production: the pooled connection string from your Postgres provider.
DATABASE_URL=
# Direct (non-pooled) connection. Prisma runs migrations over this because DDL and
# advisory locks don't survive a transaction-mode pooler. Locally, point it at the
# same database as DATABASE_URL. On Vercel, Neon sets it for you.
DATABASE_URL_UNPOOLED=

# --- Auth ---------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Only needed outside Vercel; Vercel sets the host automatically.
AUTH_TRUST_HOST=true

# --- Web push (VAPID) ---------------------------------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
# The public key is intentionally NEXT_PUBLIC_ — the browser needs it to subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services can reach you at if a subscription misbehaves.
VAPID_SUBJECT=mailto:you@example.com

# --- Photo storage ------------------------------------------------------------
# Unset locally: uploads are written to public/uploads/ so you can test offline.
# REQUIRED in production — serverless filesystems are wiped on every deploy.
# Create a Blob store in the Vercel dashboard (Storage tab) and it sets this for you.
BLOB_READ_WRITE_TOKEN=
